# AutoSieve configuration. Copy to .env and edit. Every value is optional.
# The file is read as UTF-8, so the euro sign below is safe on Windows.

# ── Scraper ──────────────────────────────────────────────────────────────────
NUM_VEHICLES=5                 # listings per run (1-500)
MARKETPLACE_CITY=lisbon        # Facebook Marketplace city slug: lisbon, porto, braga, coimbra, faro, ...
CURRENCY_SYMBOL=€
HEADLESS=false                 # headless Chromium is detected more aggressively by Facebook
# GEO_LATITUDE=38.7223         # override the browser geolocation (defaults follow the city)
# GEO_LONGITUDE=-9.1393
PAGE_TIMEOUT_MS=30000
LISTING_TIMEOUT_MS=15000
# DEBUG_HTML_DIR=debug_html    # save every fetched listing page here (or use --debug-html)

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
LLM_TIMEOUT_S=120
RETRY_ATTEMPTS=3
RETRY_DELAY_S=2

# ── OCR (needs the [ocr] extra) ──────────────────────────────────────────────
OCR_ENABLED=true               # read the odometer from photos when no mileage is found in text
OCR_GPU=false                  # CUDA only
OCR_MAX_IMAGES=6               # photos to try per listing
IMAGE_MAX_BYTES=10000000
IMAGE_TIMEOUT_S=15

# ── Deal origin (distance weighting) ─────────────────────────────────────────
# Where you are: deals farther away score lower. Defaults to Faro.
ORIGIN_LATITUDE=37.0194
ORIGIN_LONGITUDE=-7.9322

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=autosieve.db
EXPORT_DIR=.
WATCHES_PATH=watches.json

# ── Facebook session (optional, recommended) ─────────────────────────────────
# BROWSER_CHANNEL=chrome        # drive a system Chrome/Edge instead of bundled Chromium
FB_STATE_PATH=fb_state.json     # saved login from `autosieve login`

# ── Telegram alerts (for `autosieve poll`) ───────────────────────────────────
# Create a bot with @BotFather, get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
